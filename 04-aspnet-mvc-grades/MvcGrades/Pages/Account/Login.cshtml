@page
@model MvcGrades.Pages.Account.LoginModel
@{
    ViewData["Title"] = "登录";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-center align-items-center" style="min-
height:60vh;">
    <div class="card shadow-sm" style="width:420px; border-radius:0.75rem;">
        <div class="card-body p-4">
            <h4 class="card-title mb-3">
                <svg class="svg-icon" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5
0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0
0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5
3.5v2a.5.5 0 0 0 1 0v-2z" />
                    <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0
0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147
2.146a.5.5 0 0 0 .708.708l3-3z" />
                </svg> 登录
            </h4>
            <form method="post" class="needs-validation">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="mb-3">
                    <label asp-for="Login" class="form-label"></label>
                    <input name="Login" type="text" class="form-control"
                           placeholder="邮箱或用户名" />
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input name="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger">
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-centermb-3">
                    <div class="form-check">
                        <label class="form-check-label d-flex align-items-center" style="cursor:pointer;">
                            <input name="RememberMe" type="checkbox"
                                   class="form-check-input me-2" />
                            记住我
                        </label>
                    </div>
                    @* 使用显式的 btn-link 样式，保证视觉与可点击性 *@
                    <a href="/Account/Register" class="small btn btn-link p-0"
                       role="link">没有账号？注册</a>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        登录
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}