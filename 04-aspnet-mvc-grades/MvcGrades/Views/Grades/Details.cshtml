@model MvcGrades.Models.Grade
@{
    ViewData["Title"] = "成绩详情";
}
<div class="card shadow-sm border-0">
    <div class="card-header bg-info text-white py-3">
        <h4 class="mb-0"><i class="bi bi-eye me-2"></i>成绩详情</h4>
    </div>
    <div class="card-body">
        <div class="card mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 text-center mb-4 mb-md-0">
                        <div class="bg-light rounded-3 p-4">
                            <i class="bi bi-mortarboard-fill text-primary" style="font-size: 3rem;"></i>
                            <h5 class="mt-3 mb-1">成绩信息</h5>
                            <div class="display-5 fw-bold text-primary">@Html.DisplayFor(model => model.Score)</div>
                            <div class="text-muted">分数</div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="row mb-3">
                            <div class="col-sm-3 fw-bold text-muted">学生姓名</div>
                            <div class="col-sm-9">
                                <div class="alert alert-light d-inline-block px-3 py-2">
                                    <i class="bi bi-person-circle me-2 text-primary"></i>
                                    @Html.DisplayFor(model => model.Student.Name)
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-3 fw-bold text-muted">课程名称</div>
                            <div class="col-sm-9">
                                <div class="alert alert-light d-inline-block px-3 py-2">
                                    <i class="bi bi-book me-2 text-success"></i>
                                    @Html.DisplayFor(model => model.Course.Name)
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-3 fw-bold text-muted">记录ID</div>
                            <div class="col-sm-9">
                                <span class="badge bg-secondary px-3 py-2">#@Model.Id</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4">
                <i class="bi bi-pencil-square me-2"></i>编辑成绩
            </a>
            <a asp-action="Index" class="btn btn-outline-primary px-4">
                <i class="bi bi-list-ul me-2"></i>返回列表
            </a>
        </div>
    </div>
</div>