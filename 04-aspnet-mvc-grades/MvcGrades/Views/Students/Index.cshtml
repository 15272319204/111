@model IEnumerable<MvcGrades.Models.Student>
@{
    ViewData["Title"] = "学生管理";
    var currentFilter = ViewData["CurrentFilter"] as string;
    var pageNumber = ViewData["PageNumber"] as int? ?? 1;
    var pageSize = ViewData["PageSize"] as int? ?? 5;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalCount = ViewData["TotalCount"] as int? ?? 0;
}

<div class="card shadow-lg border-0">
    <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #198754 0%, #20c997 100%);">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <i class="bi bi-people-fill fs-2 me-3"></i>
                <div>
                    <h4 class="mb-1">学生管理系统</h4>
                    <p class="mb-0 opacity-75">学生信息管理与维护</p>
                </div>
            </div>
            <a asp-action="Create" class="btn btn-light btn-lg shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>新增学生
            </a>
        </div>
    </div>
    
    <div class="card-body">
        <!-- 搜索筛选卡片 -->
        <div class="card border-0 shadow-sm mb-5">
            <div class="card-body p-4">
                <form asp-action="Index" method="get" class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-primary">
                            <i class="bi bi-search me-2"></i>学生搜索
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-primary text-white">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="searchString" value="@currentFilter"
                                   class="form-control border-primary" 
                                   placeholder="搜索学生姓名、学号或账号..." />
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-success">
                            <i class="bi bi-list-columns me-2"></i>每页显示
                        </label>
                        <select name="pageSize" class="form-select form-select-lg border-success">
                            <option value="5" selected="@(pageSize == 5)">5条</option>
                            <option value="10" selected="@(pageSize == 10)">10条</option>
                            <option value="20" selected="@(pageSize == 20)">20条</option>
                            <option value="50" selected="@(pageSize == 50)">50条</option>
                        </select>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="d-grid gap-2 pt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-2"></i>搜索
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary" 
                               asp-route-pageSize="@pageSize">
                                <i class="bi bi-arrow-clockwise me-2"></i>重置
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        
        <!-- 统计信息 -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 bg-gradient-info text-dark shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title text-dark-50 mb-2">学生总数</h6>
                                <h2 class="mb-0">@totalCount</h2>
                            </div>
                            <i class="bi bi-people fs-1 opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-gradient-success text-dark shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title text-dark-50 mb-2">当前页码</h6>
                                <h2 class="mb-0">@pageNumber</h2>
                            </div>
                            <i class="bi bi-file-text fs-1 opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-gradient-warning text-dark shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title text-dark-50 mb-2">总页数</h6>
                                <h2 class="mb-0">@totalPages</h2>
                            </div>
                            <i class="bi bi-stack fs-1 opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-gradient-primary text-dark shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title text-dark-50 mb-2">每页显示</h6>
                                <h2 class="mb-0">@pageSize 条</h2>
                            </div>
                            <i class="bi bi-list-columns fs-1 opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 学生表格 -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0 text-dark">
                    <i class="bi bi-table me-2"></i>学生列表
                    <span class="badge bg-primary ms-2">@totalCount 名学生</span>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="bg-light">学生姓名</th>
                                <th class="bg-light">学号</th>
                                <th class="bg-light">关联账号</th>
                                <th class="bg-light text-center" style="width: 180px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                                <i class="bi bi-person-circle text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">@Html.DisplayFor(modelItem => item.Name)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success fs-6 px-3 py-2">
                                            @Html.DisplayFor(modelItem => item.StudentNumber)
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.User != null)
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3">
                                                    <i class="bi bi-person-badge text-info"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@item.User.UserName</div>
                                                    @if (!string.IsNullOrEmpty(item.User.Email))
                                                    {
                                                        <div class="text-muted small">@item.User.Email</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">未关联账号</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" 
                                               class="btn btn-outline-info" title="查看详情">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-outline-warning" title="编辑学生">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn btn-outline-danger" title="删除学生">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- 分页导航 -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-4">
                        <div>
                            <span class="text-muted">
                                第 <span class="fw-bold text-primary">@pageNumber</span> 页，共 <span class="fw-bold">@totalPages</span> 页
                            </span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="text-muted me-2">每页显示：</span>
                            <select name="pageSize" onchange="changePageSize(this.value)" class="form-select form-select-sm" style="width: auto;">
                                <option value="5" selected="@(pageSize == 5)">5条</option>
                                <option value="10" selected="@(pageSize == 10)">10条</option>
                                <option value="20" selected="@(pageSize == 20)">20条</option>
                                <option value="50" selected="@(pageSize == 50)">50条</option>
                            </select>
                        </div>
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination mb-0">
                            <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                                @if (pageNumber > 1)
                                {
                                    <a class="page-link" 
                                       href="@Url.Action("Index", new { 
                                           pageNumber = pageNumber - 1, 
                                           searchString = currentFilter, 
                                           pageSize = pageSize
                                       })"
                                       aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link" aria-disabled="true">
                                        <span aria-hidden="true">&laquo;</span>
                                    </span>
                                }
                            </li>
                            
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == pageNumber)
                                {
                                    <li class="page-item active" aria-current="page">
                                        <span class="page-link">@i</span>
                                    </li>
                                }
                                else if (i >= pageNumber - 2 && i <= pageNumber + 2)
                                {
                                    <li class="page-item">
                                        <a class="page-link" 
                                           href="@Url.Action("Index", new { 
                                               pageNumber = i, 
                                               searchString = currentFilter, 
                                               pageSize = pageSize
                                           })">@i</a>
                                    </li>
                                }
                                else if (i == 1 || i == totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" 
                                           href="@Url.Action("Index", new { 
                                               pageNumber = i, 
                                               searchString = currentFilter, 
                                               pageSize = pageSize
                                           })">@i</a>
                                    </li>
                                }
                                else if (i == pageNumber - 3 || i == pageNumber + 3)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }
                            
                            <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                                @if (pageNumber < totalPages)
                                {
                                    <a class="page-link" 
                                       href="@Url.Action("Index", new { 
                                           pageNumber = pageNumber + 1, 
                                           searchString = currentFilter, 
                                           pageSize = pageSize
                                       })"
                                       aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link" aria-disabled="true">
                                        <span aria-hidden="true">&raquo;</span>
                                    </span>
                                }
                            </li>
                            
                            <li class="page-item ms-3">
                                <div class="input-group">
                                    <input type="number" id="jumpPage" class="form-control" 
                                           min="1" max="@totalPages" value="@pageNumber" 
                                           style="width: 80px;" />
                                    <button class="btn btn-outline-primary" type="button" 
                                            onclick="jumpToPage()">跳转</button>
                                </div>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function jumpToPage() {
            var pageInput = document.getElementById('jumpPage');
            var pageNum = parseInt(pageInput.value);
            var totalPages = @totalPages;
            
            if (isNaN(pageNum) || pageNum < 1) pageNum = 1;
            if (pageNum > totalPages) pageNum = totalPages;
            
            // 正确的URL构建方式
            var baseUrl = '@Url.Action("Index")';
            var params = [];
            params.push('pageNumber=' + pageNum);
            
            @if (!string.IsNullOrEmpty(currentFilter))
            {
                @:params.push('searchString=' + encodeURIComponent('@currentFilter'));
            }
            
            params.push('pageSize=' + @pageSize);
            
            var url = baseUrl + '?' + params.join('&');
            window.location.href = url;
        }
        
        function changePageSize(size) {
            // 正确的URL构建方式
            var baseUrl = '@Url.Action("Index")';
            var params = [];
            params.push('pageNumber=1');
            params.push('pageSize=' + size);
            
            @if (!string.IsNullOrEmpty(currentFilter))
            {
                @:params.push('searchString=' + encodeURIComponent('@currentFilter'));
            }
            
            var url = baseUrl + '?' + params.join('&');
            window.location.href = url;
        }
        
        // 监听回车键跳转
        var jumpPageInput = document.getElementById('jumpPage');
        if (jumpPageInput) {
            jumpPageInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    jumpToPage();
                }
            });
        }
        
        // 监听页码选择框的change事件
        var pageSizeSelects = document.querySelectorAll('select[name="pageSize"]');
        pageSizeSelects.forEach(function(select) {
            select.addEventListener('change', function(e) {
                changePageSize(this.value);
            });
        });
    </script>
}