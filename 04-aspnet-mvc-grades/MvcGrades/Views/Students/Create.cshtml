@model MvcGrades.Models.Student
@{
    ViewData["Title"] = "创建学生";
    var noAccount = ViewBag.NoAvailableAccount as bool? ?? false;
}

<div class="card shadow-lg border-0">
    <div class="card-header bg-success text-white py-4">
        <div class="d-flex align-items-center">
            <i class="bi bi-person-plus-fill fs-3 me-3"></i>
            <div>
                <h4 class="mb-1">创建新学生</h4>
                <p class="mb-0 opacity-75">学生管理 > 创建学生</p>
            </div>
        </div>
    </div>

    <div class="card-body p-5">
        @if (noAccount)
        {
            <div class="alert alert-warning border-warning border-2 mb-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div>
                        <h5 class="alert-heading mb-1">无可用学生账号</h5>
                        <p class="mb-0">当前没有可用的学生账号，请先<a href="/Account/Register" class="alert-link">创建学生账号</a>。</p>
                    </div>
                </div>
            </div>
        }

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-danger"></div>

                            <div class="row g-4">
                                <!-- 学生姓名 -->
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Name" class="form-control border-2 border-primary"
                                               placeholder="学生姓名" />
                                        <label asp-for="Name" class="form-label">
                                            <i class="bi bi-person me-2"></i>学生姓名
                                        </label>
                                        <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                                    </div>
                                </div>

                                <!-- 学号 -->
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="StudentNumber" class="form-control border-2 border-success"
                                               placeholder="学号" />
                                        <label asp-for="StudentNumber" class="form-label">
                                            <i class="bi bi-card-text me-2"></i>学号
                                        </label>
                                        <span asp-validation-for="StudentNumber" class="text-danger small mt-1"></span>
                                    </div>
                                </div>

                                <!-- 关联账号 -->
                                <div class="col-12">
                                    <div class="form-floating">
                                        <select asp-for="UserId" class="form-select border-2 border-info"
                                                asp-items="ViewBag.UserId" style="height: 58px;"
                                                disabled="@(noAccount ? "disabled" : null)">
                                            <option value="">-- 请选择关联账号 --</option>
                                        </select>
                                        <label class="form-label">
                                            <i class="bi bi-person-badge me-2"></i>关联账号
                                        </label>
                                        <span asp-validation-for="UserId" class="text-danger small mt-1"></span>
                                        @if (noAccount)
                                        {
                                            <div class="form-text text-warning">
                                                <i class="bi bi-info-circle me-1"></i>无可用学生账号，请先创建学生账号
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="form-text text-muted">
                                                <i class="bi bi-info-circle me-1"></i>选择已创建的学生角色账号进行关联
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 操作按钮 -->
                            <div class="d-grid gap-3 mt-5">
                                <button type="submit" class="btn btn-success btn-lg py-3 shadow-sm"
                                        disabled="@(noAccount ? "disabled" : null)">
                                    <i class="bi bi-check-circle me-2"></i>创建学生
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg py-3">
                                    <i class="bi bi-arrow-left me-2"></i>返回列表
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}