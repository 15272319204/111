@model MvcGrades.Models.Course
@{
    ViewData["Title"] = "编辑课程";
}
<div class="card shadow-lg border-0">
    <div class="card-header bg-warning text-dark py-4">
        <div class="d-flex align-items-center">
            <i class="bi bi-pencil-square fs-3 me-3"></i>
            <div>
                <h4 class="mb-1">编辑课程</h4>
                <p class="mb-0 opacity-75">课程管理 > 课程编辑</p>
            </div>
        </div>
    </div>

    <div class="card-body p-5">
        <div class="alert alert-warning border-warning border-2" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-circle-fill me-3 fs-4"></i>
                <div>
                    <h5 class="alert-heading mb-1">注意：请谨慎修改课程信息</h5>
                    <p class="mb-0">修改课程信息可能会影响相关成绩记录，请确保数据准确性。</p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <form asp-action="Edit">
                            <input type="hidden" asp-for="Id" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-danger"></div>

                            <div class="row g-4">
                                <!-- 课程名称 -->
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Name" class="form-control border-2 border-primary"
                                               placeholder="课程名称" />
                                        <label asp-for="Name" class="form-label">
                                            <i class="bi bi-book me-2"></i>课程名称
                                        </label>
                                        <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                                    </div>
                                </div>

                                <!-- 学分 -->
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Credits" class="form-control border-2 border-success"
                                               placeholder="学分" />
                                        <label asp-for="Credits" class="form-label">
                                            <i class="bi bi-star me-2"></i>学分
                                        </label>
                                        <span asp-validation-for="Credits" class="text-danger small mt-1"></span>
                                    </div>
                                </div>

                                <!-- 任课教师 -->
                                <div class="col-12">
                                    <div class="form-floating">
                                        <select asp-for="TeacherId" class="form-select border-2 border-info"
                                                style="height: 58px;">
                                            <option value="">-- 请选择任课教师 --</option>
                                        </select>
                                        <label class="form-label">
                                            <i class="bi bi-person-badge me-2"></i>任课教师
                                        </label>
                                        <span asp-validation-for="TeacherId" class="text-danger small mt-1"></span>
                                    </div>
                                </div>

                                <!-- 学期信息（只读） -->
                                <div class="col-12">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                                                    <i class="bi bi-calendar3 text-warning fs-4"></i>
                                                </div>
                                                <div>
                                                    <div class="text-muted small mb-1">学年/学期</div>
                                                    <div class="h5 mb-0">
                                                        @if (!string.IsNullOrEmpty(Model.Semester))
                                                        {
                                                            <span class="badge bg-warning text-dark fs-5 px-3 py-2">
                                                                <i class="bi bi-calendar3 me-1"></i>@Model.Semester
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">未设置学期信息</span>
                                                        }
                                                    </div>
                                                    <div class="text-muted small mt-1">学期信息在创建时设定，不可修改</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 操作按钮 -->
                            <div class="d-grid gap-3 mt-5">
                                <button type="submit" class="btn btn-warning btn-lg py-3 shadow-sm">
                                    <i class="bi bi-check-circle me-2"></i>保存修改
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg py-3">
                                    <i class="bi bi-arrow-left me-2"></i>取消返回
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}