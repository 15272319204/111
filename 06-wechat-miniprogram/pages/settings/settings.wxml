<view class="page-container">
  <view class="settings-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-title">设置</text>
      <text class="header-desc">个性化您的观影体验</text>
    </view>
  </view>

  <view class="settings-section">
    <text class="section-title">账号设置</text>
    <view class="settings-card">
      <view class="setting-item" bindtap="goToProfile">
        <view class="setting-left">
          <view class="setting-icon profile">👤</view>
          <text class="setting-name">个人资料</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">编辑</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="goToSecurity">
        <view class="setting-left">
          <view class="setting-icon security">🔒</view>
          <text class="setting-name">账号安全</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">已保护</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="goToPrivacy">
        <view class="setting-left">
          <view class="setting-icon privacy">🔐</view>
          <text class="setting-name">隐私设置</text>
        </view>
        <view class="setting-right">
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <text class="section-title">通知设置</text>
    <view class="settings-card">
      <view class="setting-item">
        <view class="setting-left">
          <view class="setting-icon notification">🔔</view>
          <text class="setting-name">消息通知</text>
        </view>
        <view class="setting-right">
          <switch 
            checked="{{settings.messageNotification}}" 
            bindchange="toggleSetting"
            data-key="messageNotification"
            color="#e53935"
          />
        </view>
      </view>
      <view class="setting-item">
        <view class="setting-left">
          <view class="setting-icon email">📧</view>
          <text class="setting-name">邮件通知</text>
        </view>
        <view class="setting-right">
          <switch 
            checked="{{settings.emailNotification}}" 
            bindchange="toggleSetting"
            data-key="emailNotification"
            color="#e53935"
          />
        </view>
      </view>
      <view class="setting-item">
        <view class="setting-left">
          <view class="setting-icon promotion">🎁</view>
          <text class="setting-name">优惠推送</text>
        </view>
        <view class="setting-right">
          <switch 
            checked="{{settings.promotionNotification}}" 
            bindchange="toggleSetting"
            data-key="promotionNotification"
            color="#e53935"
          />
        </view>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <text class="section-title">通用设置</text>
    <view class="settings-card">
      <view class="setting-item" bindtap="goToLanguage">
        <view class="setting-left">
          <view class="setting-icon language">🌐</view>
          <text class="setting-name">语言</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">简体中文</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="goToTheme">
        <view class="setting-left">
          <view class="setting-icon theme">🎨</view>
          <text class="setting-name">主题</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">默认</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="goToCache">
        <view class="setting-left">
          <view class="setting-icon cache">💾</view>
          <text class="setting-name">清除缓存</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">12.5MB</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <text class="section-title">关于</text>
    <view class="settings-card">
      <view class="setting-item" bindtap="goToAbout">
        <view class="setting-left">
          <view class="setting-icon about">ℹ️</view>
          <text class="setting-name">关于我们</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">v1.0.0</text>
          <text class="setting-arrow">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="goToFeedback">
        <view class="setting-left">
          <view class="setting-icon feedback">💬</view>
          <text class="setting-name">意见反馈</text>
        </view>
        <view class="setting-right">
          <text class="setting-arrow">›</text>
        </view>
      </view>
      <view class="setting-item" bindtap="goToHelp">
        <view class="setting-left">
          <view class="setting-icon help">❓</view>
          <text class="setting-name">帮助中心</text>
        </view>
        <view class="setting-right">
          <text class="setting-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="logout-section">
    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>
  </view>

  <CustomTabBar />
</view>