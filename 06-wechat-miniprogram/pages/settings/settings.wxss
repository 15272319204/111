.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 130rpx;
}

.settings-header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
  display: block;
}

.settings-section {
  padding: 20rpx;
}

.section-title {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 15rpx;
  display: block;
}

.settings-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: #f8f8f8;
}

.setting-left {
  display: flex;
  align-items: center;
}

.setting-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.setting-icon.profile {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.setting-icon.security {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.setting-icon.privacy {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.setting-icon.notification {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.setting-icon.email {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.setting-icon.promotion {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.setting-icon.language {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
}

.setting-icon.theme {
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
}

.setting-icon.cache {
  background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
}

.setting-icon.about {
  background: linear-gradient(135deg, #d299c2 0%, #fef9d7 100%);
}

.setting-icon.feedback {
  background: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%);
}

.setting-icon.help {
  background: linear-gradient(135deg, #fddb92 0%, #d1fdff 100%);
}

.setting-name {
  font-size: 28rpx;
  color: #333333;
}

.setting-right {
  display: flex;
  align-items: center;
}

.setting-value {
  font-size: 24rpx;
  color: #999999;
  margin-right: 10rpx;
}

.setting-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

.logout-section {
  padding: 20rpx;
}

.logout-btn {
  background: #ffffff;
  padding: 30rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.logout-btn text {
  font-size: 30rpx;
  color: #e53935;
  font-weight: bold;
}