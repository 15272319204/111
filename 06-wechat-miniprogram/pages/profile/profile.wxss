.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 130rpx;
}

.user-section {
  background: linear-gradient(135deg, #e53935 0%, #c62828 100%);
  padding: 60rpx 30rpx 40rpx;
}

.user-header {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 25rpx;
}

.avatar-icon {
  font-size: 60rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
}

.user-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  display: block;
}

.logout-btn {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
}

.logout-btn text {
  font-size: 24rpx;
  color: #ffffff;
}

.login-section {
  padding: 40rpx 30rpx;
}

.login-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.1);
}

.login-icon {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
  display: block;
  margin-bottom: 10rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  display: block;
  margin-bottom: 40rpx;
}

/* 登录/注册主标签 */
.auth-tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 30rpx;
}

.auth-tabs .tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666666;
  border-radius: 10rpx;
  transition: all 0.3s;
  font-weight: 500;
}

.auth-tabs .tab.active {
  background: #e53935;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(229, 57, 53, 0.3);
}

/* 用户类型选择 */
.login-tabs {
  display: flex;
  background: #f8f8f8;
  border-radius: 10rpx;
  padding: 4rpx;
  margin-bottom: 30rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #666666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.type-tab.active {
  background: #ffffff;
  color: #e53935;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.form-group {
  margin-bottom: 24rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.input-wrapper:focus-within {
  border-color: #e53935;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(229, 57, 53, 0.1);
}

.input-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.form-input {
  flex: 1;
  height: 90rpx;
  font-size: 28rpx;
  background: transparent;
}

.login-btn {
  background: linear-gradient(135deg, #e53935 0%, #c62828 100%);
  padding: 30rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(229, 57, 53, 0.4);
  transition: all 0.3s;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(229, 57, 53, 0.3);
}

.login-btn text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
  display: block;
}

.register-btn {
  background: linear-gradient(135deg, #4caf50 0%, #43a047 100%);
  padding: 30rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
  transition: all 0.3s;
}

.register-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.register-btn text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
  display: block;
}

.quick-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 30rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666666;
}

.action-link {
  font-size: 24rpx;
  color: #e53935;
  font-weight: 500;
}

.menu-section {
  padding: 20rpx;
}

.menu-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s;
}

.menu-item:active {
  background: #f8f8f8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

.admin-only {
  background: linear-gradient(135deg, #fff3e0, #ffe0b2);
}

.admin-only .menu-text {
  color: #e53935;
  font-weight: 500;
}
