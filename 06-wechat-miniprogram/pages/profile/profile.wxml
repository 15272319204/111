<view class="page-container">
  <!-- 已登录状态 -->
  <view class="user-section" wx:if="{{isLoggedIn}}">
    <view class="user-header">
      <view class="user-avatar">
        <view class="avatar-icon">👤</view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.name}}</text>
        <text class="user-role">{{userInfo.isAdmin ? '管理员' : '普通用户'}}</text>
      </view>
      <view class="logout-btn" bindtap="logout">
        <text>退出登录</text>
      </view>
    </view>
  </view>

  <!-- 未登录状态 -->
  <view class="login-section" wx:else>
    <view class="login-card">
      <view class="login-icon">🎬</view>
      <text class="login-title">校园影院</text>
      <text class="login-desc">登录后可享受更多会员权益</text>
      
      <!-- 登录/注册标签切换 -->
      <view class="auth-tabs">
        <view 
          class="tab {{authMode === 'login' ? 'active' : ''}}"
          bindtap="setAuthMode"
          data-mode="login"
        >
          登录
        </view>
        <view 
          class="tab {{authMode === 'register' ? 'active' : ''}}"
          bindtap="setAuthMode"
          data-mode="register"
        >
          注册
        </view>
      </view>

      <!-- 用户类型选择（仅登录模式显示） -->
      <view class="login-tabs" wx:if="{{authMode === 'login'}}">
        <view 
          class="type-tab {{loginType === 'user' ? 'active' : ''}}"
          bindtap="setLoginType"
          data-type="user"
        >
          用户登录
        </view>
        <view 
          class="type-tab {{loginType === 'admin' ? 'active' : ''}}"
          bindtap="setLoginType"
          data-type="admin"
        >
          管理员登录
        </view>
      </view>

      <!-- 表单 -->
      <view class="form-group">
        <view class="input-wrapper">
          <text class="input-icon">👤</text>
          <input 
            class="form-input" 
            placeholder="请输入账号" 
            value="{{formData.username}}"
            bindinput="handleInput"
            data-field="username"
          />
        </view>
      </view>

      <view class="form-group">
        <view class="input-wrapper">
          <text class="input-icon">🔒</text>
          <input 
            class="form-input" 
            placeholder="请输入密码" 
            type="password"
            value="{{formData.password}}"
            bindinput="handleInput"
            data-field="password"
          />
        </view>
      </view>

      <!-- 确认密码（仅注册模式显示） -->
      <view class="form-group" wx:if="{{authMode === 'register'}}">
        <view class="input-wrapper">
          <text class="input-icon">🔐</text>
          <input 
            class="form-input" 
            placeholder="请确认密码" 
            type="password"
            value="{{formData.confirmPassword}}"
            bindinput="handleInput"
            data-field="confirmPassword"
          />
        </view>
      </view>

      <!-- 登录按钮 -->
      <view class="login-btn" bindtap="login" wx:if="{{authMode === 'login'}}">
        <text>{{loginType === 'user' ? '用户登录' : '管理员登录'}}</text>
      </view>

      <!-- 注册按钮 -->
      <view class="register-btn" bindtap="register" wx:if="{{authMode === 'register'}}">
        <text>立即注册</text>
      </view>

      <!-- 快捷操作 -->
      <view class="quick-actions" wx:if="{{authMode === 'login'}}">
        <text class="action-link" bindtap="forgotPassword">忘记密码？</text>
      </view>

      <view class="quick-actions" wx:if="{{authMode === 'register'}}">
        <text class="action-text">已有账号？</text>
        <text class="action-link" bindtap="setAuthMode" data-mode="login">立即登录</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section" wx:if="{{isLoggedIn}}">
    <view class="menu-card">
      <view class="menu-item" bindtap="goToOrder">
        <view class="menu-icon">📋</view>
        <text class="menu-text">我的订单</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToCoupons">
        <view class="menu-icon">🎟️</view>
        <text class="menu-text">优惠券</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToHistory">
        <view class="menu-icon">📖</view>
        <text class="menu-text">观影历史</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-icon">⚙️</view>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item admin-only" wx:if="{{userInfo.isAdmin}}" bindtap="goToAdmin">
        <view class="menu-icon">🔧</view>
        <text class="menu-text">管理后台</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <CustomTabBar />
</view>
