.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 180rpx;
}

.history-header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #4caf50 0%, #43a047 100%);
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
  display: block;
}

.filter-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 20rpx;
  margin: -20rpx 20rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.filter-text {
  font-size: 26rpx;
  color: #666666;
}

.filter-arrow {
  font-size: 16rpx;
  color: #999999;
  margin-left: 8rpx;
}

.filter-divider {
  width: 1rpx;
  height: 30rpx;
  background: #f0f0f0;
}

.clear-btn {
  margin-left: auto;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #e53935;
}

.history-list {
  padding: 0 20rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.group-date {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
}

.group-count {
  font-size: 22rpx;
  color: #999999;
}

.history-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.movie-poster {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.movie-poster image {
  width: 100%;
  height: 100%;
}

.movie-info {
  flex: 1;
}

.movie-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  display: block;
}

.movie-type {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
  display: block;
}

.movie-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.movie-time {
  font-size: 22rpx;
  color: #666666;
}

.movie-rating {
  font-size: 22rpx;
  color: #ffc107;
}

.movie-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx;
}

.action-icon {
  font-size: 32rpx;
  color: #4caf50;
}

.action-text {
  font-size: 20rpx;
  color: #4caf50;
  margin-top: 5rpx;
}

.empty-state {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
  display: block;
}

.empty-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
  display: block;
}

.go-btn {
  margin-top: 30rpx;
  background: linear-gradient(135deg, #4caf50 0%, #43a047 100%);
  padding: 24rpx 48rpx;
  border-radius: 40rpx;
  display: inline-block;
}

.go-btn text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
}

.bottom-action {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
}

.bottom-action .clear-btn {
  background: #ffffff;
  padding: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.bottom-action .clear-btn text {
  font-size: 28rpx;
  color: #666666;
}
